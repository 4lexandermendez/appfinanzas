// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// USUARIOS
// ============================================================

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  creadoEn     DateTime @default(now()) @map("creado_en")

  presupuestos         PresupuestoMensual[]
  gastosFijosConfig    GastoFijoConfig[]
  categoriasVariables  CategoriaVariable[]
  metasAhorro          MetaAhorro[]
  tarjetasCredito      TarjetaCredito[]
  gruposCuenta         GrupoCuenta[]
  ajusteTracker        AjusteTracker[]
  diasLibres           DiaLibre[]
  botonesRapidosConfig BotonRapidoConfig[]
  alertasConfig        AlertaConfig[]
  deudasConfig         DeudaConfig[]

  @@map("usuarios")
}

// ============================================================
// PRESUPUESTO MENSUAL (contenedor raíz de cada mes)
// ============================================================

model PresupuestoMensual {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  anio      Int     @map("anio")
  mes       Int
  notas     String? @db.Text

  usuario                Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ingresos               Ingreso[]
  ahorros                Ahorro[]
  transacciones          Transaccion[]
  trackerDiario          TrackerDiario[]
  gastosFijosMes         GastoFijoMensual[]
  deudasMes              DeudaMensual[]
  categoriasVariablesMes CategoriaVariableMensual[]
  notasHojas             NotaPresupuesto[]

  @@unique([usuarioId, anio, mes])
  @@map("presupuesto_mensual")
}

// Hojas de notas tipo pestañas (1, 2, 3...) dentro de un mes — reemplaza el
// campo "notas" de texto único de arriba, que se deja sin usar para no
// perder lo que ya habia escrito ahi (se migra sola, ver notaController).
model NotaPresupuesto {
  id            Int     @id @default(autoincrement())
  presupuestoId Int     @map("presupuesto_id")
  orden         Int
  contenido     String? @db.Text

  presupuesto PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@unique([presupuestoId, orden])
  @@map("notas_presupuesto")
}

// ============================================================
// GASTOS FIJOS (lista administrable reutilizable)
// ============================================================

// creadoEn/desactivadoEn le dan vigencia temporal a la lista: un gasto fijo
// solo debe contar en el estimado de los meses desde que se creó en adelante,
// y si se deshabilita, deja de contar desde ahí pero los meses pasados donde
// sí estuvo vigente (ya reales o estimados) no deben perder ese dato.
model GastoFijoConfig {
  id            Int       @id @default(autoincrement())
  usuarioId     Int       @map("usuario_id")
  nombre        String
  montoEstimado Decimal   @map("monto_estimado") @db.Decimal(10, 2)
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  desactivadoEn DateTime? @map("desactivado_en")

  usuario         Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  gastosMensuales GastoFijoMensual[]

  @@map("gastos_fijos_config")
}

// Registro del monto real de cada gasto fijo, mes a mes.
// No estaba en el borrador original: sin esto no había forma de
// guardar la columna "Real" de Gastos Fijos por mes.
model GastoFijoMensual {
  id                Int               @id @default(autoincrement())
  presupuestoId     Int               @map("presupuesto_id")
  gastoFijoConfigId Int               @map("gasto_fijo_config_id")
  montoEstimado     Decimal?          @map("monto_estimado") @db.Decimal(10, 2)
  montoReal         Decimal?          @map("monto_real") @db.Decimal(10, 2)
  fuente            FuenteTransaccion @default(EFECTIVO)
  tarjetaId         Int?              @map("tarjeta_id")
  cuenta            CuentaBanco?

  presupuesto       PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  gastoFijoConfig   GastoFijoConfig    @relation(fields: [gastoFijoConfigId], references: [id], onDelete: Cascade)
  tarjeta           TarjetaCredito?    @relation(fields: [tarjetaId], references: [id])
  movimientoTarjeta MovimientoTarjeta?
  aportesExternos   AporteExterno[]

  @@unique([presupuestoId, gastoFijoConfigId])
  @@map("gastos_fijos_mensual")
}

// Parte de un gasto (variable o fijo) que en realidad puso otra persona
// (te lo transfirió, te dio efectivo, etc.) — el monto total del gasto
// sigue siendo el que se cobró de verdad (ej. en la tarjeta), pero estos
// aportes se restan antes de contar contra el presupuesto/"Sin usar", ya
// que esa parte no salió de tu bolsillo. Puede haber varios (ej. un gasto
// dividido entre 3 personas), por eso es una lista y no un solo campo.
model AporteExterno {
  id                 Int     @id @default(autoincrement())
  transaccionId      Int?    @map("transaccion_id")
  gastoFijoMensualId Int?    @map("gasto_fijo_mensual_id")
  monto              Decimal @db.Decimal(10, 2)

  transaccion      Transaccion?      @relation(fields: [transaccionId], references: [id], onDelete: Cascade)
  gastoFijoMensual GastoFijoMensual? @relation(fields: [gastoFijoMensualId], references: [id], onDelete: Cascade)

  @@map("aportes_externos")
}

// ============================================================
// INGRESOS (por presupuesto mensual)
// ============================================================

model Ingreso {
  id            Int       @id @default(autoincrement())
  presupuestoId Int       @map("presupuesto_id")
  nombre        String
  montoEstimado Decimal   @map("monto_estimado") @db.Decimal(10, 2)
  montoReal     Decimal?  @map("monto_real") @db.Decimal(10, 2)
  fecha         DateTime? @db.Date

  presupuesto PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@map("ingresos")
}

// ============================================================
// CATEGORÍAS VARIABLES (Transporte y Comida son es_default = true)
// ============================================================

model CategoriaVariable {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @map("usuario_id")
  nombre    String
  esDefault Boolean @default(false) @map("es_default")

  usuario         Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  transacciones   Transaccion[]
  presupuestosMes CategoriaVariableMensual[]

  @@unique([usuarioId, nombre])
  @@map("categorias_variables")
}

// Estimado que el usuario escribe cada mes para una categoría variable
// (ej. "Temu $44.23", "Universidad $256.52"). No estaba en el borrador:
// el Real ya se sacaba solo de las transacciones, pero no había dónde
// guardar el Estimado que el usuario piensa gastar ese mes.
model CategoriaVariableMensual {
  id            Int     @id @default(autoincrement())
  presupuestoId Int     @map("presupuesto_id")
  categoriaId   Int     @map("categoria_id")
  montoEstimado Decimal @map("monto_estimado") @db.Decimal(10, 2)

  presupuesto PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  categoria   CategoriaVariable  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([presupuestoId, categoriaId])
  @@map("categorias_variables_mensual")
}

// ============================================================
// TRANSACCIONES (gastos variables individuales del mes)
// ============================================================

// EXTERNO = alguien mas te dio ese dinero (te lo transfirio o te lo dio en
// efectivo) para cubrir el gasto, no salio de tu bolsillo. CUENTA_BANCO es
// una transferencia directa desde una de tus cuentas (ver enum CuentaBanco),
// distinto de pagar con la tarjeta de credito.
enum FuenteTransaccion {
  EFECTIVO
  TARJETA
  CUENTA_BANCO
  EXTERNO
}

enum CuentaBanco {
  CUSCATLAN
  MULTIMONEY
  BAC
  AGRICOLA_PRINCIPAL
  AGRICOLA_SECUNDARIA
}

model Transaccion {
  id            Int               @id @default(autoincrement())
  presupuestoId Int               @map("presupuesto_id")
  categoriaId   Int               @map("categoria_id")
  monto         Decimal           @db.Decimal(10, 2)
  fecha         DateTime          @db.Date
  notas         String?           @db.Text
  fuente        FuenteTransaccion @default(EFECTIVO)
  tarjetaId     Int?              @map("tarjeta_id")
  cuenta        CuentaBanco?

  presupuesto       PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  categoria         CategoriaVariable  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  tarjeta           TarjetaCredito?    @relation(fields: [tarjetaId], references: [id])
  movimientoTarjeta MovimientoTarjeta?
  aportesExternos   AporteExterno[]

  @@map("transacciones")
}

// ============================================================
// TRACKER DIARIO (Transporte y Comida, día a día)
// ============================================================

enum ConceptoTracker {
  PASAJE_IDA
  DESAYUNO
  ALMUERZO
  PASAJE_REGRESO
}

model TrackerDiario {
  id            Int             @id @default(autoincrement())
  presupuestoId Int             @map("presupuesto_id")
  fecha         DateTime        @db.Date
  concepto      ConceptoTracker
  monto         Decimal         @db.Decimal(10, 2)

  presupuesto PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@map("tracker_diario")
}

// ============================================================
// AHORROS (por presupuesto mensual)
// ============================================================

model Ahorro {
  id            Int      @id @default(autoincrement())
  presupuestoId Int      @map("presupuesto_id")
  nombre        String
  montoEstimado Decimal  @map("monto_estimado") @db.Decimal(10, 2)
  montoReal     Decimal? @map("monto_real") @db.Decimal(10, 2)

  presupuesto PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@map("ahorros")
}

// ============================================================
// METAS DE AHORRO
// ============================================================

model MetaAhorro {
  id            Int       @id @default(autoincrement())
  usuarioId     Int       @map("usuario_id")
  nombre        String
  montoObjetivo Decimal   @map("monto_objetivo") @db.Decimal(10, 2)
  montoActual   Decimal   @default(0) @map("monto_actual") @db.Decimal(10, 2)
  fechaLimite   DateTime? @map("fecha_limite") @db.Date

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("metas_ahorro")
}

// ============================================================
// DEUDAS (no tarjetas de crédito; ej. préstamos, deudas personales)
// No estaba en la sección 5 del borrador: el Excel sí tenía la sección
// "Deudas" (Nombre | Estimado | Real | Actual) en cada mes, pero nunca
// se modeló ninguna tabla para ella.
// ============================================================

// creadoEn/desactivadoEn: mismo motivo que en GastoFijoConfig, una deuda
// solo debe contar en el estimado de los meses desde que se creó en adelante.
model DeudaConfig {
  id            Int       @id @default(autoincrement())
  usuarioId     Int       @map("usuario_id")
  nombre        String
  saldoActual   Decimal   @default(0) @map("saldo_actual") @db.Decimal(10, 2)
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  desactivadoEn DateTime? @map("desactivado_en")

  usuario         Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  deudasMensuales DeudaMensual[]

  @@map("deudas_config")
}

model DeudaMensual {
  id            Int      @id @default(autoincrement())
  presupuestoId Int      @map("presupuesto_id")
  deudaConfigId Int      @map("deuda_config_id")
  montoEstimado Decimal? @map("monto_estimado") @db.Decimal(10, 2)
  montoReal     Decimal? @map("monto_real") @db.Decimal(10, 2)

  presupuesto PresupuestoMensual @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  deudaConfig DeudaConfig        @relation(fields: [deudaConfigId], references: [id], onDelete: Cascade)

  @@unique([presupuestoId, deudaConfigId])
  @@map("deudas_mensual")
}

// ============================================================
// GRUPOS DE CUENTA (por banco: agrupa cuentas bancarias y, si aplica,
// la tarjeta de crédito de ese banco)
// ============================================================

model GrupoCuenta {
  id        Int    @id @default(autoincrement())
  usuarioId Int    @map("usuario_id")
  nombre    String
  orden     Int    @default(0)

  usuario  Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cuentas  CuentaBancaria[]
  tarjetas TarjetaCredito[]

  @@map("grupos_cuenta")
}

model CuentaBancaria {
  id          Int     @id @default(autoincrement())
  grupoId     Int     @map("grupo_id")
  nombre      String
  saldoActual Decimal @default(0) @map("saldo_actual") @db.Decimal(10, 2)

  grupo         GrupoCuenta        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  tarjetaDebito TarjetaDebito?
  movimientos   MovimientoCuenta[]

  @@map("cuentas_bancarias")
}

model TarjetaDebito {
  id       Int    @id @default(autoincrement())
  cuentaId Int    @unique @map("cuenta_id")
  nombre   String

  cuenta CuentaBancaria @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@map("tarjetas_debito")
}

// monto positivo = entrada (deposito / transferencia recibida)
// monto negativo = salida (retiro / transferencia enviada)
model MovimientoCuenta {
  id          Int      @id @default(autoincrement())
  cuentaId    Int      @map("cuenta_id")
  monto       Decimal  @db.Decimal(10, 2)
  fecha       DateTime @db.Date
  descripcion String?
  // Solo un check visual (ej. "ya lo revisé") — no afecta ningún cálculo.
  revisado    Boolean  @default(false)

  cuenta CuentaBancaria @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@map("movimientos_cuenta")
}

// ============================================================
// TARJETAS DE CRÉDITO
// ============================================================

model TarjetaCredito {
  id                   Int     @id @default(autoincrement())
  usuarioId            Int     @map("usuario_id")
  grupoId              Int?    @map("grupo_id")
  nombre               String
  limite               Decimal @db.Decimal(10, 2)
  diaCorte             Int     @map("dia_corte")
  diaPago              Int     @map("dia_pago")
  saldoActual          Decimal @default(0) @map("saldo_actual") @db.Decimal(10, 2)
  // No estaba en el borrador: sin esto no se puede calcular "diferencia entre
  // pago mínimo y pago total" que pide la sección 3 de PLANIFICACION.md.
  porcentajePagoMinimo Decimal @default(5) @map("porcentaje_pago_minimo") @db.Decimal(5, 2)

  usuario          Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grupo            GrupoCuenta?        @relation(fields: [grupoId], references: [id])
  movimientos      MovimientoTarjeta[]
  transacciones    Transaccion[]
  gastosFijosMes   GastoFijoMensual[]

  @@map("tarjetas_credito")
}

model MovimientoTarjeta {
  id                 Int      @id @default(autoincrement())
  tarjetaId          Int      @map("tarjeta_id")
  monto              Decimal  @db.Decimal(10, 2)
  fecha              DateTime @db.Date
  descripcion        String?
  transaccionId      Int?     @unique @map("transaccion_id")
  gastoFijoMensualId Int?     @unique @map("gasto_fijo_mensual_id")
  // Solo un check visual (ej. "ya lo revisé") — no afecta ningún cálculo.
  revisado           Boolean  @default(false)

  tarjeta          TarjetaCredito    @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)
  transaccion      Transaccion?      @relation(fields: [transaccionId], references: [id])
  gastoFijoMensual GastoFijoMensual? @relation(fields: [gastoFijoMensualId], references: [id])

  @@map("movimientos_tarjeta")
}

// ============================================================
// AJUSTES DEL TRACKER (estimado automático transporte/comida)
// ============================================================

// Cada fila es una version vigente desde creadoEn en adelante (hasta la
// siguiente version, si existe). Al guardar cambios se crea una fila nueva
// en vez de sobreescribir, asi los dias ya pasados del mes conservan los
// montos que estaban vigentes cuando ocurrieron, en vez de recalcularse con
// el monto mas reciente.
model AjusteTracker {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  creadoEn  DateTime @default(now()) @map("creado_en")

  montoPasajeIda           Decimal @map("monto_pasaje_ida") @db.Decimal(10, 2)
  montoDesayuno            Decimal @map("monto_desayuno") @db.Decimal(10, 2)
  montoAlmuerzo            Decimal @map("monto_almuerzo") @db.Decimal(10, 2)
  montoPasajeRegreso       Decimal @map("monto_pasaje_regreso") @db.Decimal(10, 2)
  montoPasajeSabadoIda     Decimal @map("monto_pasaje_sabado_ida") @db.Decimal(10, 2)
  montoDesayunoSabado      Decimal @map("monto_desayuno_sabado") @db.Decimal(10, 2)
  montoPasajeSabadoRegreso Decimal @map("monto_pasaje_sabado_regreso") @db.Decimal(10, 2)

  patronSabadoInicio      DateTime @map("patron_sabado_inicio") @db.Date
  patronSabadoPrimerDiaVa Boolean  @map("patron_sabado_primer_dia_va")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, creadoEn])
  @@map("ajustes_tracker")
}

// ============================================================
// DÍAS LIBRES (marcados manualmente, se excluyen del estimado)
// ============================================================

enum MotivoDiaLibre {
  VACACION
  ASUETO
  DESCANSO
  OTRO
}

model DiaLibre {
  id        Int            @id @default(autoincrement())
  usuarioId Int            @map("usuario_id")
  fecha     DateTime       @db.Date
  motivo    MotivoDiaLibre

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, fecha])
  @@map("dias_libres")
}

// ============================================================
// BOTONES RÁPIDOS (montos frecuentes por concepto, tipo cajero)
// ============================================================

model BotonRapidoConfig {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  concepto  String
  monto1    Decimal  @map("monto_1") @db.Decimal(10, 2)
  monto2    Decimal? @map("monto_2") @db.Decimal(10, 2)
  monto3    Decimal? @map("monto_3") @db.Decimal(10, 2)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, concepto])
  @@map("botones_rapidos_config")
}

// ============================================================
// ALERTAS
// ============================================================

model AlertaConfig {
  id               Int     @id @default(autoincrement())
  usuarioId        Int     @map("usuario_id")
  tipo             String
  porcentajeAlerta Int?    @map("porcentaje_alerta")
  activo           Boolean @default(true)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo])
  @@map("alertas_config")
}
